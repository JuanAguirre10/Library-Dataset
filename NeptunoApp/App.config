<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    La cadena de conexion vive en el proyecto de INICIO (la aplicacion WPF),
    no en la biblioteca de clases de datos. ConfigurationManager busca el
    archivo de configuracion del ejecutable que arranca el proceso
    (NeptunoApp.dll.config, generado a partir de este App.config); un App.config
    colocado dentro de NeptunoApp.Data no se copia ni se lee nunca.
  -->
  <connectionStrings>
    <add name="NeptunoDB"
         connectionString="Server=.\SQLEXPRESS;Database=NeptunoDB_Lab06;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
