<Window x:Class="NeptunoApp.Views.ProveedorEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VentanaDialogo}"
        Title="{Binding TituloVentana}" Height="520" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding TituloVentana}" Style="{StaticResource TituloSeccion}"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                <TextBlock Text="Compañía" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox x:Name="CompaniaBox" Style="{StaticResource CampoTexto}" MaxLength="60"
                         Text="{Binding CompaniaNombre, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="Nombre de contacto" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="40"
                         Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="Cargo del contacto" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="40"
                         Text="{Binding CargoContacto, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                <TextBlock Text="Dirección" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="80"
                         Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="Ciudad" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="30"
                         Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="Código postal" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="10"
                         Text="{Binding CodigoPostal, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="País" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="30"
                         Text="{Binding Pais, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="Teléfono" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="24"
                         Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="Fax" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="24"
                         Text="{Binding Fax, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Click="Cancelar_Click" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                    Click="Guardar_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
