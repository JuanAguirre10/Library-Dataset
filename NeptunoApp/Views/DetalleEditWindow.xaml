<Window x:Class="NeptunoApp.Views.DetalleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VentanaDialogo}"
        Title="{Binding TituloVentana}" Height="380" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding TituloVentana}" Style="{StaticResource TituloSeccion}"
                   Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Producto" Style="{StaticResource EtiquetaCampo}"/>
            <ComboBox x:Name="ProductoCombo" ItemsSource="{Binding Productos}"
                      SelectedItem="{Binding ProductoSeleccionado}"
                      DisplayMemberPath="NombreProducto"
                      IsEnabled="{Binding EsNueva}"/>
            <TextBlock Text="El producto no se puede cambiar en una línea existente; quítela y agréguela de nuevo."
                       Style="{StaticResource TextoAyuda}" Margin="0,6,0,0"
                       Visibility="{Binding EsNueva, Converter={StaticResource BoolToVisibility},
                                    ConverterParameter=Invert}"/>
        </StackPanel>

        <Grid Grid.Row="2" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Precio unitario" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}"
                         Text="{Binding PrecioUnidad, StringFormat='N2', UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Cantidad" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}"
                         Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Descuento (%)" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}"
                         Text="{Binding DescuentoPorcentaje, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Click="Cancelar_Click" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                    Click="Guardar_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
