<Window x:Class="NeptunoApp.Views.PedidoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VentanaDialogo}"
        Title="{Binding TituloVentana}" Height="520" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding TituloVentana}" Style="{StaticResource TituloSeccion}"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="Cliente" Style="{StaticResource EtiquetaCampo}"/>
                <ComboBox x:Name="ClienteCombo" ItemsSource="{Binding Clientes}"
                          SelectedItem="{Binding ClienteSeleccionado}"
                          DisplayMemberPath="Empresa"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="Empleado" Style="{StaticResource EtiquetaCampo}"/>
                <ComboBox ItemsSource="{Binding Empleados}"
                          SelectedItem="{Binding EmpleadoSeleccionado}"
                          DisplayMemberPath="NombreCompleto"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="Fecha del pedido" Style="{StaticResource EtiquetaCampo}"/>
                <DatePicker SelectedDate="{Binding FechaPedido}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="Fecha requerida" Style="{StaticResource EtiquetaCampo}"/>
                <DatePicker SelectedDate="{Binding FechaRequerida}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="Fecha de envío" Style="{StaticResource EtiquetaCampo}"/>
                <DatePicker SelectedDate="{Binding FechaEnvio}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="Transportista" Style="{StaticResource EtiquetaCampo}"/>
                <ComboBox ItemsSource="{Binding Transportistas}"
                          SelectedItem="{Binding TransportistaSeleccionado}"
                          DisplayMemberPath="CompaniaNombre"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                <TextBlock Text="Destinatario" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="60"
                         Text="{Binding Destinatario, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="Ciudad de destino" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="30"
                         Text="{Binding CiudadDestino, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                <TextBlock Text="País de destino" Style="{StaticResource EtiquetaCampo}"/>
                <TextBox Style="{StaticResource CampoTexto}" MaxLength="30"
                         Text="{Binding PaisDestino, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Click="Cancelar_Click" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                    Click="Guardar_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
