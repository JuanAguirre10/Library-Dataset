<Application x:Class="NeptunoApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NeptunoApp.Converters"
             xmlns:vm="clr-namespace:NeptunoApp.ViewModels"
             xmlns:views="clr-namespace:NeptunoApp.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumEqualsConverter x:Key="EnumEquals"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:StringNullOrEmptyToVisibilityConverter x:Key="TextoToVisibility"/>

            <!-- Cada modulo se dibuja con la vista que le corresponde. -->
            <DataTemplate DataType="{x:Type vm:ProductosViewModel}">
                <views:ProductosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CategoriasViewModel}">
                <views:CategoriasView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProveedoresViewModel}">
                <views:ProveedoresView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PedidosViewModel}">
                <views:PedidosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportesViewModel}">
                <views:ReportesView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
