<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Paleta ===================== -->
    <Color x:Key="FondoColor">#F3F5F8</Color>
    <Color x:Key="SuperficieColor">#FFFFFF</Color>
    <Color x:Key="SuperficieAlternaColor">#F8FAFC</Color>
    <Color x:Key="BordeColor">#E2E6EB</Color>
    <Color x:Key="BordeSuaveColor">#EEF1F4</Color>
    <Color x:Key="AcentoColor">#2563A8</Color>
    <Color x:Key="AcentoHoverColor">#1E528D</Color>
    <Color x:Key="AcentoPresionadoColor">#194575</Color>
    <Color x:Key="AcentoSuaveColor">#EAF1F9</Color>
    <Color x:Key="TextoPrimarioColor">#1F2937</Color>
    <Color x:Key="TextoSecundarioColor">#6B7280</Color>
    <Color x:Key="PeligroColor">#B42318</Color>
    <Color x:Key="PeligroSuaveColor">#FEF3F2</Color>
    <Color x:Key="ExitoColor">#067647</Color>
    <Color x:Key="ExitoSuaveColor">#ECFDF3</Color>
    <Color x:Key="AvisoColor">#B54708</Color>
    <Color x:Key="AvisoSuaveColor">#FFFAEB</Color>

    <!-- Barra lateral oscura -->
    <Color x:Key="BarraColor">#1B2533</Color>
    <Color x:Key="BarraHoverColor">#253245</Color>
    <Color x:Key="BarraActivoColor">#2C3B51</Color>
    <Color x:Key="BarraTextoColor">#AEB8C6</Color>
    <Color x:Key="BarraTextoTenueColor">#6F7C8E</Color>
    <Color x:Key="BarraBordeColor">#2A3546</Color>
    <Color x:Key="BarraAcentoColor">#5B9BE0</Color>

    <SolidColorBrush x:Key="FondoBrush" Color="{StaticResource FondoColor}"/>
    <SolidColorBrush x:Key="SuperficieBrush" Color="{StaticResource SuperficieColor}"/>
    <SolidColorBrush x:Key="SuperficieAlternaBrush" Color="{StaticResource SuperficieAlternaColor}"/>
    <SolidColorBrush x:Key="BordeBrush" Color="{StaticResource BordeColor}"/>
    <SolidColorBrush x:Key="BordeSuaveBrush" Color="{StaticResource BordeSuaveColor}"/>
    <SolidColorBrush x:Key="AcentoBrush" Color="{StaticResource AcentoColor}"/>
    <SolidColorBrush x:Key="AcentoHoverBrush" Color="{StaticResource AcentoHoverColor}"/>
    <SolidColorBrush x:Key="AcentoPresionadoBrush" Color="{StaticResource AcentoPresionadoColor}"/>
    <SolidColorBrush x:Key="AcentoSuaveBrush" Color="{StaticResource AcentoSuaveColor}"/>
    <SolidColorBrush x:Key="TextoPrimarioBrush" Color="{StaticResource TextoPrimarioColor}"/>
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="{StaticResource TextoSecundarioColor}"/>
    <SolidColorBrush x:Key="PeligroBrush" Color="{StaticResource PeligroColor}"/>
    <SolidColorBrush x:Key="PeligroSuaveBrush" Color="{StaticResource PeligroSuaveColor}"/>
    <SolidColorBrush x:Key="ExitoBrush" Color="{StaticResource ExitoColor}"/>
    <SolidColorBrush x:Key="ExitoSuaveBrush" Color="{StaticResource ExitoSuaveColor}"/>
    <SolidColorBrush x:Key="AvisoBrush" Color="{StaticResource AvisoColor}"/>
    <SolidColorBrush x:Key="AvisoSuaveBrush" Color="{StaticResource AvisoSuaveColor}"/>
    <SolidColorBrush x:Key="BarraBrush" Color="{StaticResource BarraColor}"/>
    <SolidColorBrush x:Key="BarraHoverBrush" Color="{StaticResource BarraHoverColor}"/>
    <SolidColorBrush x:Key="BarraActivoBrush" Color="{StaticResource BarraActivoColor}"/>
    <SolidColorBrush x:Key="BarraTextoBrush" Color="{StaticResource BarraTextoColor}"/>
    <SolidColorBrush x:Key="BarraTextoTenueBrush" Color="{StaticResource BarraTextoTenueColor}"/>
    <SolidColorBrush x:Key="BarraBordeBrush" Color="{StaticResource BarraBordeColor}"/>
    <SolidColorBrush x:Key="BarraAcentoBrush" Color="{StaticResource BarraAcentoColor}"/>

    <FontFamily x:Key="FuenteIconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===================== Base ===================== -->
    <!-- WPF no aplica estilos implicitos a clases derivadas (MainWindow, ventanas de
         edicion), por eso cada ventana asigna este estilo de forma explicita. -->
    <Style x:Key="Ventana" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource FondoBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="VentanaDialogo" TargetType="Window" BasedOn="{StaticResource Ventana}">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Los estilos con clave heredan del implicito para conservar la alineacion vertical. -->
    <Style x:Key="TituloSeccion" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Subtitulo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TextoAyuda" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="EtiquetaCampo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#4B5563"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- ===================== Contenedores ===================== -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Etiqueta de estado (Disponible, Reponer, Descontinuado...) -->
    <Style x:Key="Insignia" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextoInsignia" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===================== Botones ===================== -->
    <!-- El ContentPresenter declara un estilo de TextBlock vacio: sin el, el estilo
         implicito de TextBlock de la aplicacion pisa el Foreground del boton y el texto
         de los botones primario y de peligro se ve oscuro. -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource AcentoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AcentoHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AcentoPresionadoBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AcentoHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="BorderBrush" Value="#D0D5DD"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"/>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource SuperficieAlternaBrush}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="#98A2B3"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BordeSuaveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="Foreground" Value="{StaticResource PeligroBrush}"/>
        <Setter Property="BorderBrush" Value="#F4C7C3"/>
    </Style>

    <!-- Boton de la barra lateral. Tag = glifo del icono. -->
    <Style x:Key="BotonNavegacion" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="10,2"/>
        <Setter Property="Foreground" Value="{StaticResource BarraTextoBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="6">
                        <Grid>
                            <Border x:Name="Marca" Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" Background="{StaticResource BarraAcentoBrush}"
                                    Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Margin="14,10">
                                <TextBlock x:Name="Icono" Text="{TemplateBinding Tag}"
                                           FontFamily="{StaticResource FuenteIconos}" FontSize="16"
                                           Foreground="{TemplateBinding Foreground}"
                                           Width="20" Margin="0,0,12,0"/>
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock"/>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BarraHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BarraActivoBrush}"/>
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icono" Property="Foreground" Value="{StaticResource BarraAcentoBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Campos ===================== -->
    <Style x:Key="CampoTexto" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#D0D5DD"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="#98A2B3"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                            <Setter TargetName="Borde" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource SuperficieAlternaBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox plano, con el mismo borde y radio que los campos de texto
         (la plantilla por defecto de Windows usa un degradado gris). -->
    <ControlTemplate x:Key="ComboBoxBoton" TargetType="ToggleButton">
        <Border x:Name="Borde" Background="{StaticResource SuperficieBrush}" BorderBrush="#D0D5DD"
                BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="Flecha" Text="&#xE70D;" FontFamily="{StaticResource FuenteIconos}" FontSize="10"
                       Foreground="{StaticResource TextoSecundarioBrush}"
                       HorizontalAlignment="Right" Margin="0,0,12,0"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Borde" Property="BorderBrush" Value="#98A2B3"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource AcentoBrush}"/>
                <Setter TargetName="Flecha" Property="Foreground" Value="{StaticResource AcentoBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Boton" Template="{StaticResource ComboBoxBoton}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter IsHitTestVisible="False" Margin="10,0,32,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource SuperficieBrush}" BorderBrush="{StaticResource BordeBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="0,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fondo" Background="Transparent" Padding="{TemplateBinding Padding}"
                            Margin="4,0" CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource SuperficieAlternaBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource AcentoSuaveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="#D0D5DD"/>
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===================== Grillas ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BordeSuaveBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SuperficieAlternaBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Celdas de texto: DataGridTextColumn usa un estilo explicito propio, asi que el recorte
         con puntos suspensivos se asigna columna por columna con ElementStyle. -->
    <Style x:Key="CeldaTexto" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SuperficieAlternaBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AcentoSuaveBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Avisos ===================== -->
    <Style x:Key="PanelError" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PeligroSuaveBrush}"/>
        <Setter Property="BorderBrush" Value="#FECDCA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

</ResourceDictionary>
